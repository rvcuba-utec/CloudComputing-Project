# Demo local (sin backend). Poner "false" para usar los microservicios reales.
VITE_USE_MOCKS=true

# URL del API Gateway (incluye el stage si tu API lo usa, p. ej. .../amazonaws.com/prod).
# El frontend agrega los prefijos reales de cada servicio:
#   - Catálogo (Go):      /api/catalogo/...
#   - Usuarios (FastAPI): /usuarios/...
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_HOST
