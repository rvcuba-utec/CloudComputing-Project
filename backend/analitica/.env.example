JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Athena / Glue (blueprint §9). Sin estas variables, /analitica/* responde 503:
# el servicio no inventa datos si el data lake no está desplegado.
AWS_REGION=us-east-1
ATHENA_DATABASE=cloudshop_analytics
ATHENA_WORKGROUP=primary
# Bucket S3 donde Athena escribe los resultados de cada consulta.
ATHENA_OUTPUT_S3=s3://cloudshop-data-lake-2026-utec-mr-cs2032-v2/athena-results/
