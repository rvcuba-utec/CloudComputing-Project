# ============================================================================
# CloudShop · Plantilla de variables de despliegue
#
# Copiar este archivo (sin sufijo) en:
#   Backend/.env        → usado por docker-compose.yml (VM dev/app)
#                        y docker-compose.datos.yml (VM de datos)
#   Data/scripts/.env   → usado por load_csv_bd.py (el loader reusa las
#                        mismas variables de conexión)
#
# El archivo .env real NUNCA se versiona (solo esta plantilla).
# ============================================================================

# --- VM de datos: ubicación (IP PRIVADA de la VPC, nunca localhost) ---------
MYSQL_HOST=10.0.1.20
MYSQL_PORT=3306

# --- MySQL (catálogo) --------------------------------------------------------
MYSQL_DATABASE=cloudshop_catalogo
MYSQL_USER=cloud_user
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root

# --- PostgreSQL (usuarios) ----------------------------------------------------
PG_USER=cloud_user
PG_PASSWORD=cambia_esta_clave
PG_DATABASE=cloudshop_usuarios
# El microservicio de usuarios usa SQLAlchemy + psycopg2 (esquema de la URL):
DATABASE_URL=postgresql+psycopg2://cloud_user:cambia_esta_clave@10.0.1.20:5432/cloudshop_usuarios

# --- Microservicio de usuarios (FastAPI) -------------------------------------
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Origen público del frontend en AWS Amplify + desarrollo local:
CORS_ORIGINS=https://TU-APP.amplifyapp.com,http://localhost:5173
