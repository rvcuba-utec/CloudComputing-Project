# Variables para el docker-compose (copiar a .env y editar).
# En la VM, las IPs son las privadas de la VM de DATOS dentro de la VPC.

# ===== Microservicio de usuarios (PostgreSQL en la VM de datos) =====
DATABASE_URL=postgresql+psycopg2://usuarios_app:CAMBIA_ESTA_CLAVE@10.0.1.10:5432/cloudshop_usuarios
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Microservicio de catalogo (MySQL en la VM de datos) =====
MYSQL_HOST=10.0.1.10
MYSQL_PORT=3306
MYSQL_USER=cloud_user
MYSQL_PASSWORD=CAMBIA_ESTA_CLAVE
MYSQL_DATABASE=cloudshop_catalogo
